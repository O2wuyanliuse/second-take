#!/bin/sh
# second-take 推送前强制核验（第二重保险）
# 装法：git config core.hooksPath .githooks   （tools/bootstrap.py 会顺手设）
#
# 2026-11-21 v3：钩子只做三件事——找到 python、确认工具与词表在、把 push 清单交给判据。
# 判据全在 tools/verify_release.py --push-gate（本地与 CI 同一份代码），它逐 ref 判：
# 树里有没有词表、该 ref 自己的全部历史里有没有命中、版本 tag 的包有没有封条。
# 旧版只核工作区 HEAD，推旧历史分支时钩子看不见——那是绕过口，已堵。
set -u

repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo .)
cd "$repo_root" || exit 1

find_py() {
  if [ -n "${SECOND_TAKE_PYTHON:-}" ] && [ -x "${SECOND_TAKE_PYTHON}" ]; then
    echo "${SECOND_TAKE_PYTHON}"; return 0
  fi
  if [ -f .git/second-take-python ]; then
    p=$(cat .git/second-take-python 2>/dev/null)
    if [ -n "$p" ] && [ -x "$p" ]; then echo "$p"; return 0; fi
  fi
  for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1; then echo "$c"; return 0; fi
  done
  echo ""
}

PY=$(find_py)
if [ -z "$PY" ]; then
  echo ""
  echo "[blocked] 找不到 python，无法核验 → 拒绝推送。"
  echo "  装 python，或把解释器路径写进 .git/second-take-python（或设 SECOND_TAKE_PYTHON）。"
  exit 1
fi

TOOL="tools/verify_release.py"
if [ ! -f "$TOOL" ]; then
  echo ""
  echo "[blocked] 缺少 $TOOL，无法核验 → 拒绝推送。"
  echo "  这不是「跳过」，是配置坏了：删掉脚本不能成为绕过方式。"
  exit 1
fi

WORDS="${SECOND_TAKE_WORDS:-.ci/denylist.txt}"
if [ ! -s "$WORDS" ]; then
  echo ""
  echo "[blocked] 找不到词表：$WORDS"
  echo "  设 SECOND_TAKE_WORDS=<私库词表>，或把它放到 .ci/denylist.txt（已 gitignore）。"
  echo "  没有词表就核不了——核不了不许推。"
  exit 1
fi

# stdin 上的推送清单原样交给判据（钩子不解析它，少一处能写错的地方）。
"$PY" -X utf8 "$TOOL" --push-gate --words "$WORDS"
rc=$?
if [ "$rc" -ne 0 ]; then
  echo ""
  echo "[blocked] 核验未通过（退出码 $rc）→ 拒绝推送。"
  echo "  绿才推。红了就改，不要改这个钩子。旧历史只留本地 bundle，不要 git push --all / --mirror。"
  exit 1
fi

echo ""
echo "[ok] 核验通过，放行。"
exit 0
