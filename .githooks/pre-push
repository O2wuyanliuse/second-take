#!/bin/sh
# 推前：再查一遍（`pre-commit` 可被 `--no-verify` 绕过，这一层补上）
#
# 严格做法是只扫「本次要推的范围」，但 `_leakscan` 是按仓库扫的，没有范围参数。
# 当前树这一层已经能挡住「我改完忘了清」；历史里有没有，由发布前那一遍
# `--deny … --strict`（全量 blob）兜。
#
# ⚠ 本库退出码约定：0 绿 ／ 1 阻断 ／ 2 提示。2 不算红。

echo "[pre-push] 脱敏（公库禁用词，只看当前树）…"
python packaging/_leakscan.py --deny packaging/public_denylist.txt --no-history
rc=$?
if [ "$rc" -eq 1 ]; then
    echo "[pre-push] 有命中 —— 不推。清完再来。" >&2
    exit 1
fi
if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
    echo "[pre-push] 没查成（退出码 $rc）—— **不算通过**，别推。" >&2
    exit "$rc"
fi

echo "[pre-push] 通过。真要发版，记得另外跑一遍全历史："
echo "  python packaging/_leakscan.py --deny packaging/public_denylist.txt --strict"
